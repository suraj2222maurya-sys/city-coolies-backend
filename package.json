{
  "name": "city-coolies-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone City Coolies Node.js API backend",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsup src/server.ts --format esm --platform node --target node20 --clean --sourcemap",
    "start": "node dist/server.js",
    "check": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^4.21.2",
    "nodemailer": "^7.0.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.1",
    "@types/nodemailer": "^7.0.1",
    "tsx": "^4.20.5",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  }
}
